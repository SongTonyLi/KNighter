+const MemRegion *SAGenTestChecker::getBaseRegion(const MemRegion *MR) const {
+  if (!MR)
+    return nullptr;
+
+  const MemRegion *Cur = MR;
+  while (const auto *SR = dyn_cast<SubRegion>(Cur)) {
+    const MemRegion *Super = SR->getSuperRegion();
+    if (!Super)
+      break;
+    Cur = Super;
+  }
+  return Cur ? Cur : MR;
 }
 
