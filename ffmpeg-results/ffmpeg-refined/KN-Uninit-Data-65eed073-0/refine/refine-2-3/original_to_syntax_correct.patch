+bool SAGenTestChecker::isCheckedRegion(const MemRegion *MR,
+                                       CheckerContext &C) const {
+  if (!MR)
+    return false;
+
+  ProgramStateRef State = C.getState();
+  return State->contains<CheckedShortReadRegions>(MR);
 }
 
